                                "color(\"#A1DAB4\")"
                            ],
                            [
                                "${hoogte} >= 10 && ${hoogte} < 15",
                                "color(\"#41B6C4\")"
                            ],
                            [
                                "${hoogte} >= 15 && ${hoogte} < 25",
                                "color(\"#2C7FB8\")"
                            ],
                            [
                                "${hoogte} >= 25",
                                "color(\"#253494\")"
                            ],
                            [
                                "true",
                                "color(\"#ededed\")"
                            ]
                        ],
                        "legend": [
                            { "color": "#FFFFCC", "label": "Lager dan 6 m" },
                            { "color": "#A1DAB4", "label": "6 - 10 m" },
                            { "color": "#41B6C4", "label": "10 - 15 m" },
                            { "color": "#2C7FB8", "label": "15 - 25 m" },
                            { "color": "#253494", "label": "25 m en hoger" },
                            { "color": "#ededed", "label": "Onbekend" }
                        ]
                    },
                    {
                        "title": "Daktype",
                        "conditions": [
                            [
                                "${daktype} === 'slanted'",
