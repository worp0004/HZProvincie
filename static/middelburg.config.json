                            { "color": "#1034A6", "label": "1990 en later" },
                            { "color": "#ededed", "label": "Onbekend" }
                        ]
                    },
                    {
                        "title": "Hoogte",
                        "defines": {
                            "hoogte": "Number(${dakhoogte_max}) - Number(${maaiveldhoogte})"
